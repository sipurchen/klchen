# Model blobs — too large, and may contain personal data from Ollama store
ollama_models/
*.gguf
*.bin
*.safetensors

# Node
node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo
.env
*.egg-info/

# OS
.DS_Store
Thumbs.db

# TTS output wav (generated at runtime)
tests/assets/tts_out.wav
tests/assets/tts_direct_out.wav

# Sensitive env files
.env
*.env
secrets.*

# Local machine paths (gitignored; copy from *.example.* and fill in)
config/paths.ps1
config/paths.py
config/paths.sh

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# llama.cpp prebuilt binaries (56MB+, unmodified upstream release) —
# download via bin/README.md instead of tracking in git
bin/*.zip
bin/llama-cpp/

# Runtime benchmark/probe logs (generated, machine-specific)
logs/

# Expert-affinity v2 corpus: regeneratable intermediate files (D×3 imatrix input files, job lists).
# Keep turns/*.json (scripted prompts), sessions/*.{body.txt,turns.jsonl,spans.json} (real generated
# content), and exports/ (human-readable span dumps) — those are the actual corpus, not derived.
data/routing_corpus_v2/imatrix_inputs/
data/routing_corpus_v2/jobs.json
data/routing_corpus_v2/jobs_summary.json
